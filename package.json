{
  "name": "worksphere",
  "version": "1.0.0",
  "private": true,
  "description": "WorkSphere Enterprise Work & Project Management Platform (MERN)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build:backend": "npm --workspace=backend run build",
    "build:frontend": "npm --workspace=frontend run build",
    "build": "npm --workspace=backend run build && npm --workspace=frontend run build",
    "lint": "npm --workspace=frontend run lint",
    "seed": "npm --workspace=backend run seed"
  },
  "dependencies": {
    "@sentry/node": "^11.4.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/multer": "^2.3.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  }
}
